# .gitignore — Call Center CRM

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
env/
venv/

# Environment variables (the real .env is never committed; .env.example is)
.env
.env.*
!.env.example

# ML model (regenerate with ml/train_model.py)
ml/model.pkl

# Generated data (regenerate with ml/generate_dataset.py)
data/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db


# Logs and local planning notes
*.log
plan_call_center.md
