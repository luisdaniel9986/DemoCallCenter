              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Has classification\", () => pm.expect([\"High\",\"Medium\",\"Low\"]).to.include(pm.response.json().classification));"
